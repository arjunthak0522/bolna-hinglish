{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gemini.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
